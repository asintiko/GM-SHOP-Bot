# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Owner IDs (comma-separated)
OWNER_IDS=123456789,987654321

# Admin Log Channel ID
ADMIN_LOG_CHAT_ID=-1001234567890

# Main Group Chat ID (optional - can be configured via bot)
MAIN_CHAT_ID=-1001234567890

# Database Configuration
DATABASE_URL=postgresql://gmshop_user:gmshop_password@postgres:5432/gmshop
POSTGRES_PASSWORD=gmshop_password

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Timezone
TZ=Europe/Moscow

# Logging
LOG_LEVEL=INFO

# Features Toggle (optional)
ENABLE_MARRIAGES=true
ENABLE_KARMA=true
ENABLE_WEEKLY_TOP=true
ENABLE_GIVEAWAYS=true

# Development Mode (optional)
DEV_MODE=false
